# ==============================================================================
# FinReason-Agent Environment Configuration Template
# 复制本文件为 .env 并填入实际 API Key (可选，离线模式无需配置)
# ==============================================================================

# 1. 大模型 API 配置 (支持 OpenAI / DeepSeek / 通义千问 / 智谱 GLM 等兼容端点)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. 默认模型选择 (若不填将自动采用 configs/default.yaml 预设)
FINREASON_ROUTER_MODEL=gpt-4o-mini
FINREASON_TIER1_MODEL=gpt-4o-mini
FINREASON_TIER2_MODEL=gpt-4o
FINREASON_TIER3_MODEL=gpt-4o

# 3. 沙箱与微服务配置
FINREASON_SANDBOX_TIMEOUT=15
FINREASON_API_HOST=0.0.0.0
FINREASON_API_PORT=8000
